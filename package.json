{
  "name": "soombook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@soombook/reader-web",
    "setup:workspace": "node scripts/setupWorkspace.mjs",
    "build": "npm run build --workspace=@soombook/reader-web && npm run check:pack-build && npm run check:build-budget",
    "build:pages": "node scripts/buildPages.mjs",
    "build:review-candidate": "node scripts/buildReviewCandidate.mjs",
    "build:pwa-update-fixtures": "node scripts/buildPwaUpdateFixtures.mjs",
    "preview": "npm run preview --workspace=@soombook/reader-web",
    "preview:pages": "node scripts/previewPages.mjs",
    "check:docs": "python scripts/check_project_docs.py",
    "content:sync": "node scripts/demoContent.mjs --write",
    "review-candidate:sync": "node scripts/compileReviewCandidate.mjs --write",
    "fixture-audio:sync": "node scripts/generateFixtureAudio.mjs --write",
    "icons:sync": "node scripts/generatePwaIcons.mjs",
    "check:content": "node scripts/demoContent.mjs --check",
    "check:review-candidate": "node scripts/compileReviewCandidate.mjs --check",
    "check:representative-review": "node scripts/checkRepresentativeReview.mjs",
    "check:device-matrix": "node scripts/checkDeviceMatrix.mjs",
    "check:performance-evidence": "node scripts/checkPerformanceEvidence.mjs",
    "check:public-release-evidence": "node scripts/checkPublicReleaseEvidence.mjs",
    "check:product-baseline": "node scripts/checkProductBaseline.mjs",
    "review:decide": "node scripts/decideRepresentativeReview.mjs",
    "check:rights-review": "node --experimental-strip-types scripts/prepareRightsReview.mjs --check",
    "rights-review:verify": "node --experimental-strip-types scripts/verifyRightsApproval.mjs",
    "check:fixture-audio": "node scripts/generateFixtureAudio.mjs --check",
    "check:assets": "node scripts/checkPackAssets.mjs",
    "check:pack-build": "node scripts/checkBookPackBuild.mjs",
    "check:fixtures": "node scripts/checkFixturePortability.mjs",
    "validator:sync": "node --experimental-strip-types scripts/generateBookPackValidator.mjs --write",
    "check:validator": "node --experimental-strip-types scripts/generateBookPackValidator.mjs --check",
    "check:build-budget": "node scripts/checkBuildBudget.mjs",
    "check:pages-build": "node scripts/checkPagesBuild.mjs",
    "check:review-build": "node scripts/checkReviewBuild.mjs",
    "check:text": "node scripts/checkTextPolicy.mjs",
    "check:source": "node scripts/checkPublicSource.mjs",
    "check:project": "node scripts/checkProject.mjs",
    "check:expert-reviews": "node scripts/checkExpertReviews.mjs",
    "check:expert-reviews:device": "node scripts/checkExpertReviews.mjs --device-matrix",
    "check:expert-reviews:release": "node scripts/checkExpertReviews.mjs --public-release",
    "check:expert-reviews:baseline": "node scripts/checkExpertReviews.mjs --product-baseline",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:contracts": "vitest run packages/book-schema packages/book-authoring packages/test-book-factory tests/audit/binaryPolicy.test.mjs tests/audit/bookPackIntegrity.test.mjs tests/audit/bookPackBuildContract.test.mjs tests/audit/representativeReview.test.mjs tests/audit/deviceMatrixContract.test.mjs tests/audit/publicReleaseEvidence.test.mjs tests/audit/productBaseline.test.mjs apps/reader-web/src/loadDemoBookPack.test.ts apps/reader-web/src/bookAssetLoader.test.ts apps/reader-web/src/bookPackWorkerContract.test.ts apps/reader-web/src/interactionPointerTarget.test.ts apps/reader-web/src/narrationAudio.test.ts apps/reader-web/src/serviceWorkerLifecycle.test.ts",
    "test:unit": "vitest run packages/book-runtime",
    "test:e2e": "playwright test tests/e2e --project=chromium --project=mobile",
    "test:e2e:all": "playwright test tests/e2e --workers=1",
    "test:e2e:compatibility": "playwright test tests/e2e --project=firefox --project=webkit --workers=1",
    "test:audio-fixture": "playwright test --config=playwright.audio.config.ts",
    "test:review-candidate:browser": "playwright test --config=playwright.review.config.ts",
    "test:review-candidate": "node scripts/runReviewCandidateTests.mjs",
    "qa:product-baseline": "npm run build:review-candidate && npm run check:product-baseline",
    "qa:ui": "playwright test tests/ui/uiAudit.spec.ts --project=chromium --project=tablet --project=mobile",
    "qa:device-matrix": "node scripts/runDeviceMatrix.mjs",
    "qa:performance": "node scripts/runPerformanceAudit.mjs",
    "qa:performance:profile": "playwright test --config=playwright.performance.config.ts",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "test:pages:built": "node scripts/runBuiltPagesTests.mjs",
    "test:pages:remote": "playwright test --config=playwright.remote.config.ts",
    "test:pwa-update": "playwright test --config=playwright.pwa-update.config.ts",
    "check:release:automated": "npm run qa:performance && npm run check:expert-reviews:release && npm run check:full && npm run build:pages && npm run check:public-release-evidence -- --current-pages && npm run test:pages:built",
    "check": "npm run check:docs && npm run check:text && npm run check:source && npm run check:project && npm run check:expert-reviews && npm run check:fixture-audio && npm run check:content && npm run check:review-candidate && npm run check:representative-review && npm run check:rights-review && npm run check:assets && npm run check:fixtures && npm run check:validator && npm run format:check && npm run typecheck && npm run lint && npm run test:contracts && npm run test:unit",
    "check:full": "npm run check && npm run build && npm run test:e2e && npm run test:audio-fixture && npm run test:review-candidate && npm run check:product-baseline && npm run check:expert-reviews:baseline && npm run test:pwa-update && npm run qa:ui && npm run qa:device-matrix && npm run check:expert-reviews:device",
    "test": "npm run check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
